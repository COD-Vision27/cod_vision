+fn process_sp_plan(
+    mut commands: Commands,
+    plan_sub: Res<TopicSubscriber<SpGimbalPlanTopic>>,
+    mut metrics: ResMut<SimulationMetrics>,
+    mut fire_rate_limiter: ResMut<FireRateLimiter>,
+    clock: Res<RoboMasterClock>,
+    gimbal: Single<
+        (Entity, Option<&mut GimbalAimTracker>, &GlobalTransform),
+        (With<Controlled>, With<InfantryGimbal>),
+    >,
+    muzzle: Single<&Transform, (With<Controlled>, With<InfantryLaunchOffset>)>,
+) {
+    let Ok(Some(plan)) = plan_sub.try_recv() else {
+        return;
+    };
+    let (entity, mut tracker, gimbal_world) = gimbal.into_inner();
+    let now = Clock::to_builtin_time(&clock.lock().unwrap().get_now().unwrap());
+    let age = (now.sec as f64 - plan.header.stamp.sec as f64)
+        + (now.nanosec as f64 - plan.header.stamp.nanosec as f64) * 1e-9;
+    let values = [
+        plan.yaw,
+        plan.pitch,
+        plan.yaw_vel,
+        plan.pitch_vel,
+        plan.yaw_acc,
+        plan.pitch_acc,
+        plan.max_yaw_acc,
+        plan.max_pitch_acc,
+        plan.valid_for,
+    ];
+    if !plan.control
+        || plan.header.frame_id != "map"
+        || age < -0.02
+        || age >= plan.valid_for
+        || values.iter().any(|v| !v.is_finite())
+        || plan.max_yaw_acc <= 0.0
+        || plan.max_pitch_acc <= 0.0
+        || !(0.01..=1.0).contains(&plan.valid_for)
+    {
+        commands.entity(entity).remove::<GimbalAimTracker>();
+        return;
+    }
+    metrics.record_gimbal_command(
+        "sp_ros2",
+        plan.yaw.to_degrees() as f32,
+        (90.0 - plan.pitch.to_degrees()) as f32,
+        0.0,
+        plan.fire,
+    );
+    // Projectile points along muzzle-local +Y, while SP's zero-pitch forward is -Z in Bevy.
+    let target = GimbalAimTarget {
+        yaw: plan.yaw as f32,
+        pitch: -plan.pitch as f32 - PI / 2.0,
+    };
+    let motion = crate::systems::SpMotionPlan::new(
+        plan.yaw_vel as f32,
+        -plan.pitch_vel as f32,
+        plan.yaw_acc as f32,
+        -plan.pitch_acc as f32,
+        plan.max_yaw_acc as f32,
+        plan.max_pitch_acc as f32,
+        (plan.valid_for - age.max(0.0)) as f32,
+    );
+    match tracker.as_mut() {
+        Some(tracker) => tracker.retarget_sp(target, motion),
+        None => {
+            let mut tracker = GimbalAimTracker::new(target);
+            tracker.retarget_sp(target, motion);
+            commands.entity(entity).insert(tracker);
+        }
+    }
+    if plan.fire
+        && crate::systems::sp_fire_aligned(target, gimbal_world.rotation() * muzzle.rotation, 0.01)
+        && fire_rate_limiter.allow() {
+        commands.queue(|world: &mut World| {
+            world.run_system_once(projectile_launch).unwrap();
+        });
+    }
+}
