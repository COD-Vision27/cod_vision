{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "本地：环境检查",
      "type": "process",
      "command": "python3",
      "args": [
        "tools/local_run.py",
        "doctor"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "本地：轻量检查",
      "type": "process",
      "command": "python3",
      "args": [
        "tools/local_run.py",
        "check"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "本地：构建",
      "type": "process",
      "command": "python3",
      "args": [
        "tools/local_run.py",
        "build"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "本地：完整测试",
      "type": "process",
      "command": "python3",
      "args": [
        "tools/local_run.py",
        "test"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "group": {
        "kind": "test",
        "isDefault": true
      }
    },
    {
      "label": "本地：仿真窗口",
      "type": "process",
      "command": "python3",
      "args": [
        "tools/local_run.py",
        "sim"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ]
}
